---
interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}

const { data } = Astro.props;

// Escape <, >, & to prevent XSS in JSON-LD (required for Astro set:html)
const escapeJson = (value: unknown): string =>
  JSON.stringify(value, null, 2)
    .replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026");

// One <script> per schema object (P19, 2026-11-21). A single block holding an array is valid JSON-LD, but the house
// crawler (qc-site.py via advertools) reads only the first object of a top-level array and reported "no
// BreadcrumbList" on 10,529 pages whose breadcrumb was the second item. Separate blocks read the same everywhere.
const blocks = Array.isArray(data) ? data : [data];
---
{blocks.map((block) => <script type="application/ld+json" set:html={escapeJson(block)} />)}
