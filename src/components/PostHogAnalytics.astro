---
// Privacy-first PostHog analytics (see /privacy, "Analytics").
// - Renders nothing unless PUBLIC_POSTHOG_TOKEN is set at build time.
// - Cookieless: no cookies, localStorage or sessionStorage (cookieless_mode "always"), so no
//   consent banner is needed for this configuration. Unique visitors are counted with
//   PostHog's daily-salted server-side hash. Requires "Cookieless server hash mode" to be
//   enabled in the PostHog project settings.
// - No person profiles, no session replay, no surveys. Autocapture limited to clicks on
//   links and buttons, so form fields are never captured.
// - Global Privacy Control or Do Not Track set in the browser = PostHog is never loaded.
// - Traffic goes through the site's own Worker at /lv-relay (worker/posthog-relay.ts).
// - Deferred: the SDK loads after window load + browser idle, off the critical rendering path.
const token = import.meta.env.PUBLIC_POSTHOG_TOKEN;
const uiHost = import.meta.env.PUBLIC_POSTHOG_UI_HOST ?? "https://us.posthog.com";
const config = {
  api_host: "/lv-relay",
  ui_host: uiHost,
  defaults: "2026-08-30",
  cookieless_mode: "always",
  person_profiles: "never",
  disable_session_recording: true,
  disable_surveys: true,
  respect_dnt: true,
  capture_performance: true,
  autocapture: {
    dom_event_allowlist: ["click"],
    element_allowlist: ["a", "button"],
  },
};
---

{token && (
  <script is:inline define:vars={{ token, config }}>
    (function () {
      var nav = window.navigator;
      if (nav.globalPrivacyControl === true || nav.doNotTrack === "1") return;
      // The SDK is ~103 KB compressed. Load it only after the page has finished loading and the
      // browser is idle, so it never competes with rendering or interactivity.
      var start = function () {
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],Object.defineProperty(u,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e}}),Object.defineProperty(u.people,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(){return u.toString(1)+".people (stub)"}}),o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagResult reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      window.posthog.init(token, config);
      };
      var whenIdle = function () {
        if ("requestIdleCallback" in window) window.requestIdleCallback(start, { timeout: 4000 });
        else window.setTimeout(start, 1500);
      };
      if (document.readyState === "complete") whenIdle();
      else window.addEventListener("load", whenIdle, { once: true });
    })();
  </script>
)}
