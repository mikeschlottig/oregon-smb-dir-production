---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface StatItem {
  value: string;
  label: string;
}

interface Props {
  breadcrumb: BreadcrumbItem[];
  eyebrow: string;
  title: string;
  tagline: string;
  stats: StatItem[];
  badge?: string;
  county?: string;
  /** Owner-supplied banner shown beside the title (src/data/listingBanners.ts). */
  image?: { src: string; alt: string; width: number; height: number };
}

const { breadcrumb, eyebrow, title, tagline, stats, badge, county, image } = Astro.props;
---

<section class="relative" style={`background-color: var(--c-pine);`}>
  <div class="container mx-auto px-4 py-16 md:py-24">
    <!-- Breadcrumb — rendered from the same trail that produces the BreadcrumbList
         JSON-LD (see src/lib/breadcrumbs.ts). data-crumb marks each label so the
         build gate can diff the visible trail against the markup. -->
    <nav aria-label="Breadcrumb" data-breadcrumb class="text-sm mb-6" style={`color: var(--c-copper-lt);`}>
      <ol class="flex flex-wrap items-center gap-2">
        {breadcrumb.map((item, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true" class="text-white/40">/</span>}
            {item.href ? (
              <a data-crumb href={item.href} class="hover:text-white transition-colors">{item.label}</a>
            ) : (
              <span data-crumb aria-current="page" class="text-white">{item.label}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <div class={image ? "grid gap-10 md:grid-cols-2 md:items-center" : ""}>
    <div>
    <!-- Eyebrow with optional badge -->
    <div class="flex items-center gap-3 mb-3">
      <p class="eyebrow text-sm uppercase tracking-widest" style={`color: var(--c-copper);`}>
        {county ? `${eyebrow} · ${county} County` : eyebrow}
      </p>
      {badge && (
        <span class="inline-flex items-center gap-1 text-xs font-semibold px-2 py-1 rounded-full" style={{ backgroundColor: 'var(--c-copper-lt)', color: 'var(--c-pine)' }}>
          {badge}
        </span>
      )}
    </div>

    <!-- H1 Title (inside card as per spec) -->
    <h1 class="font-playfair text-4xl md:text-6xl font-bold text-white mb-4 leading-tight">
      {title}
    </h1>

    <!-- Tagline -->
    <p class="text-lg md:text-xl mb-8 max-w-2xl" style={`color: var(--c-sky);`}>
      {tagline}
    </p>

    <!-- Stats Row -->
    <div class="flex flex-wrap gap-6 md:gap-8">
      {stats.map((stat) => (
        <div class="flex flex-col">
          <span class="stat text-3xl md:text-4xl" style={`color: var(--c-copper-lt);`}>
            {stat.value}
          </span>
          <span class="text-sm mt-1" style={`color: var(--c-sky);`}>
            {stat.label}
          </span>
        </div>
      ))}
    </div>
    </div>

    {image && (
      <img
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="eager"
        decoding="async"
        class="w-full h-auto rounded-xl shadow-lg"
      />
    )}
    </div>
  </div>
</section>
