---
import "@/styles/globals.css";
import { Navbar } from "@/components/layout/Navbar";
import { Footer } from "@/components/layout/Footer";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Oregon SMB Directory — Ashland to Portland Metro",
  description = "Oregon's premier business directory for cities along the I-5 corridor — from Ashland to Portland Metro. 12 cities, 12 industries, thousands of trusted local businesses.",
  image = "/og-default.jpg",
  ogType = "website",
  jsonLd,
} = Astro.props;

const pathname = Astro.url.pathname;
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(pathname, origin).toString();
const imageUrl = new URL(image, origin).toString();

const escapeJsonLd = (value: unknown): string =>
  JSON.stringify(value).replace(/</g, "\\u003c").replace(/>/g, "\\u003e").replace(/&/g, "\\u0026");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:site_name" content="Oregon SMB Directory" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLd && (
      <script type="application/ld+json" set:html={escapeJsonLd(jsonLd)} />
    )}
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      <Navbar pathname={pathname} client:load />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
