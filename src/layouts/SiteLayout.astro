---
import "@/styles/tokens.css";
import "@/styles/globals.css";
import { Navbar } from "@/components/layout/Navbar";
import { Footer } from "@/components/layout/Footer";
import JsonLd from "@/components/JsonLd.astro";
import { publisher } from "@/data/publisher";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article";
  /**
   * Keep the URL reachable but out of the index. Used for sections that exist
   * structurally but carry no publishable content yet — an empty section that ranks
   * is worse than one that is simply not offered to the index.
   */
  noindex?: boolean;
  /**
   * "utility" marks contact / policy / accessibility pages. They are indexable and
   * deliberately short: the build gate's word floor is a content-page rule and reads
   * this attribute to know which pages it governs.
   */
  pageKind?: "content" | "utility";
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  schemas?: any[];
  /** Exclude this entire page from Pagefind search index (e.g. paginated listing slices) */
  pagefindIgnore?: boolean;
  /** Primary city scope for Pagefind filters and result badges */
  city?: string;
  /** Primary industry scope for Pagefind filters and result badges */
  industry?: string;
  /** Page classification for Pagefind search (e.g. business, service, category, city, guide) */
  pageType?: "business" | "service" | "category" | "city" | "guide" | "content";
}

const {
  title = `${publisher.name} — Statewide Local Business Records`,
  description = publisher.description,
  image = "/og-default.jpg",
  ogType = "website",
  noindex = false,
  pageKind = "content",
  schemas,
  pagefindIgnore = false,
  city,
  industry,
  pageType,
} = Astro.props;

const pathname = Astro.url.pathname;
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(pathname, origin).toString();
const imageUrl = new URL(image, origin).toString();

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@600&display=swap"
      rel="stylesheet"
    />
    <style>
      /* Typography from design spec */
      h1 { font-family: var(--font-playfair); font-weight: 700; }
      h2 { font-family: var(--font-playfair); font-weight: 700; }
      h3, .card-title { font-family: var(--font-inter); font-weight: 600; }
      body, .body-text { font-family: var(--font-inter); font-weight: 400; }
      .eyebrow { font-family: var(--font-inter); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; }
      .stat, .mono { font-family: var(--font-jetbrains); font-weight: 600; }
    </style>

    <meta property="og:site_name" content="Oregon SMB Directory" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {schemas && schemas.length > 0 && <JsonLd data={schemas} />}
  </head>
  <body data-page-kind={pageKind}>
    <div class="min-h-screen flex flex-col">
      <div data-pagefind-ignore="all">
        <Navbar pathname={pathname} client:load />
      </div>
      <main
        class="flex-1"
        {...(pagefindIgnore ? { "data-pagefind-ignore": "all" } : { "data-pagefind-body": true })}
      >
        {city && (
          <span
            style="display:none;"
            data-pagefind-meta="city"
            data-pagefind-filter="city"
          >
            {city}
          </span>
        )}
        {industry && (
          <span
            style="display:none;"
            data-pagefind-meta="industry"
            data-pagefind-filter="industry"
          >
            {industry}
          </span>
        )}
        {pageType && (
          <span
            style="display:none;"
            data-pagefind-meta="type"
            data-pagefind-filter="type"
          >
            {pageType}
          </span>
        )}
        <slot />
      </main>
      <div data-pagefind-ignore="all">
        <Footer />
      </div>
    </div>
  </body>
</html>
