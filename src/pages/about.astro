---
// About page (P19, 2026-11-21). The house standard (STD-SEO-001 row 12) requires an About page linked from the
// footer; /about/ returned 404. Every statement here restates something the site already publishes (publisher.ts,
// the privacy policy's operator line, the editorial policy) or is counted from the listing data at build time.
// AboutPage describes the organization; no Person is named (docs/STANDARDS-AUDIT-2026-11-21.md D6).
import SiteLayout from "@/layouts/SiteLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { publisher } from "@/data/publisher";
import { cities } from "@/data/cities";
import { industries } from "@/data/industries";
import { getBusinesses } from "@/data/businesses";
import { trail, visibleTrail, breadcrumbListSchema } from "@/lib/breadcrumbs";

const listingCount = cities.reduce(
  (sum, c) => sum + industries.reduce((s, i) => s + getBusinesses(c.slug, i.slug).length, 0),
  0,
);
const fmt = new Intl.NumberFormat("en-US");

const title = `About — ${publisher.name}`;
const description = `${publisher.name} is a statewide directory of Oregon small businesses, published by ${publisher.legalOperator} in ${publisher.locationLabel}. Here is how it works.`;

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const crumbs = trail([{ name: "About" }]);
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: title,
    url: `${siteUrl}/about/`,
    description,
    about: {
      "@type": "Organization",
      "@id": publisher.id,
      name: publisher.name,
      legalName: publisher.legalOperator,
      url: siteUrl,
      email: publisher.supportEmail,
      telephone: publisher.supportPhone,
    },
  },
  breadcrumbListSchema(crumbs, siteUrl),
];
---

<SiteLayout title={title} description={description} schemas={schemas} pageKind="utility">
  <header class="bg-muted pt-32 pb-12 px-4 border-b border-border">
    <div class="container mx-auto max-w-3xl">
      <Breadcrumbs crumbs={visibleTrail(crumbs)} class="mb-4" />
      <p class="text-accent text-sm uppercase tracking-widest mb-3">About</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold mb-4">About {publisher.name}</h1>
      <p class="text-muted-foreground text-lg">{publisher.description}</p>
    </div>
  </header>

  <article class="container mx-auto max-w-3xl px-4 py-14 prose prose-lg">
    <h2>What is here</h2>
    <p>
      {fmt.format(listingCount)} local business records across {cities.length} Oregon cities and {industries.length} industries.
      You can browse <a href="/city/">by city</a>, by industry within a city, or <a href="/services/">by service</a>, and each
      listing shows the contact details and map the directory holds for that business.
    </p>

    <h2>Who publishes it</h2>
    <p>
      {publisher.name} is published by {publisher.legalOperator} in {publisher.locationLabel}.
    </p>

    <h2>Where the listings come from</h2>
    <p>
      Every record carries a label that says what kind of evidence stands behind each detail, and a record only appears
      once it passes the directory's publication gates. The <a href={publisher.editorialPolicyUrl}>editorial and data quality
      policy</a> explains the labels, the gates, how rankings and sponsorship are handled, and how corrections work.
    </p>

    <h2>Listing, correcting or claiming a business</h2>
    <p>
      A business can ask to be listed, <a href={publisher.correctionUrl}>correct its record</a> or
      <a href={publisher.claimUrl}>claim it</a> through the contact form.
    </p>

    <h2>Contact</h2>
    <p>
      Email <a href={`mailto:${publisher.supportEmail}`}>{publisher.supportEmail}</a>, call
      <a href={`tel:${publisher.supportPhone}`}>{publisher.supportPhoneDisplay}</a>, or use the
      <a href="/contact/">contact page</a>.
    </p>
  </article>
</SiteLayout>
