---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { bestOfLists } from "@/data/content";
import { breadcrumbSchema } from "@/lib/schema";
import { ArrowRight, Trophy } from "lucide-react";

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Best Of — Oregon SMB Directory",
    url: `${siteUrl}/best-of`,
    description: "Editor-curated rankings of the standout businesses in every city we cover — built from customer reviews, expert reporting, and on-the-ground visits.",
  },
  breadcrumbSchema([
    { name: "Home", url: siteUrl },
    { name: "Best Of", url: `${siteUrl}/best-of` },
  ]),
];
---
<SiteLayout title="Best Of — Oregon SMB Directory" schemas={schemas}>
  <section class="bg-muted pt-32 pb-16 px-4 border-b border-border">
    <div class="container mx-auto max-w-4xl text-center">
      <p class="text-accent text-sm uppercase tracking-widest mb-3">Best Of 2026</p>
      <h1 class="font-serif text-5xl md:text-6xl font-bold mb-4">
        The <span class="italic text-accent">Best Of</span> the I-5
      </h1>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Editor-curated rankings of the standout businesses in every city we cover — built from
        customer reviews, expert reporting, and on-the-ground visits.
      </p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
      {bestOfLists.map((b) => (
        <a
          href={`/best-of/${b.slug}`}
          class="group bg-card border border-border rounded-xl overflow-hidden hover:shadow-elegant hover:-translate-y-1 transition-all duration-300 flex flex-col"
        >
          <div class="bg-gradient-warm px-7 py-6 text-white">
            <div class="flex items-center gap-2 text-xs uppercase tracking-widest opacity-90 mb-2">
              <Trophy className="w-4 h-4 text-gold" />
              {b.category} · {b.year}
            </div>
            <h2 class="font-serif text-2xl font-bold leading-snug">{b.title}</h2>
            <p class="text-white/80 text-sm mt-2">{b.city}</p>
          </div>
          <div class="p-7 flex-1 flex flex-col">
            <p class="text-muted-foreground text-sm leading-relaxed flex-1">{b.intro}</p>
            <div class="mt-5 text-xs text-muted-foreground">
              Top picks: {b.picks.slice(0, 3).map((p) => p.name).join(" · ")}
            </div>
            <span class="mt-5 inline-flex items-center gap-2 text-primary font-medium text-sm group-hover:gap-3 transition-all">
              See the full list <ArrowRight className="w-4 h-4" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
