---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { getCollection, render } from "astro:content";
import { cities } from "@/data/cities";
import { blogPostSchema } from "@/lib/schema";
import { trail, visibleTrail, breadcrumbListSchema } from "@/lib/breadcrumbs";
import { ChevronRight, Calendar, Clock, User, MapPin } from "lucide-react";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const formatDate = (iso: string) => {
  if (!iso) return "";
  const d = new Date(iso + "T00:00:00");
  if (isNaN(d.getTime())) return iso;
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
};

const tocHeadings = headings.filter((h: any) => h.depth === 2 || h.depth === 3);

/**
 * Most blog posts cover small I-5 towns that have no directory page — only the twelve
 * cities in `cities` do. Linking the byline town unconditionally produced 40 dead
 * internal links, so the label stays plain text unless the page actually exists.
 */
const hasCityPage = cities.some((c) => c.slug === post.data.citySlug);

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const crumbs = trail([
  { name: "Blog", path: "/blog/" },
  { name: post.data.title },
]);
const schemas = [
  blogPostSchema(post, siteUrl),
  breadcrumbListSchema(crumbs, siteUrl),
];
---
<SiteLayout
  title={`${post.data.title} — Oregon SMB Directory Blog`}
  description={post.data.excerpt}
  schemas={schemas}
>
  <article class="pt-32 pb-20 px-4">
    <div class="container mx-auto max-w-3xl">
      <Breadcrumbs crumbs={visibleTrail(crumbs)} class="mb-6" />

      <p class="text-accent text-xs font-medium uppercase tracking-widest mb-4">{post.data.category}</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight mb-6">{post.data.title}</h1>
      <p class="text-xl text-muted-foreground leading-relaxed mb-8">{post.data.excerpt}</p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted-foreground pb-8 border-b border-border">
        <span class="inline-flex items-center gap-2"><User className="w-4 h-4 text-accent" />{post.data.author}</span>
        {post.data.date && <span class="inline-flex items-center gap-2"><Calendar className="w-4 h-4 text-accent" />{formatDate(post.data.date)}</span>}
        {post.data.readTime && <span class="inline-flex items-center gap-2"><Clock className="w-4 h-4 text-accent" />{post.data.readTime}</span>}
        {post.data.city && (
          hasCityPage ? (
            <a href={`/city/${post.data.citySlug}/`} class="inline-flex items-center gap-2 hover:text-foreground">
              <MapPin className="w-4 h-4 text-accent" />{post.data.city}
            </a>
          ) : (
            <span class="inline-flex items-center gap-2">
              <MapPin className="w-4 h-4 text-accent" />{post.data.city}
            </span>
          )
        )}
      </div>

      {post.data.topics.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {post.data.topics.map((t) => (
            <span class="text-xs uppercase tracking-wider bg-muted text-muted-foreground px-2.5 py-1 rounded-full">{t}</span>
          ))}
        </div>
      )}

      {tocHeadings.length >= 3 && (
        <nav aria-label="Table of contents" class="mt-10 p-6 rounded-xl border border-border bg-muted/40">
          <p class="text-xs uppercase tracking-widest text-muted-foreground mb-3">Contents</p>
          <ol class="space-y-1.5 text-sm">
            {tocHeadings.map((h: any) => (
              <li class={h.depth === 3 ? "pl-4" : ""}>
                <a href={`#${h.slug}`} class="text-foreground/80 hover:text-primary">{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="mt-10 prose prose-lg max-w-none prose-headings:font-serif prose-headings:scroll-mt-24 prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-3 prose-h3:text-2xl prose-a:text-primary prose-a:underline prose-a:underline-offset-2 prose-strong:text-foreground prose-li:text-foreground/90 prose-p:text-foreground/90 prose-p:leading-relaxed prose-table:text-sm prose-th:bg-muted prose-th:text-left prose-th:p-3 prose-td:p-3 prose-td:border prose-td:border-border prose-th:border prose-th:border-border [&_aside.callout]:my-6 [&_aside.callout]:rounded-xl [&_aside.callout]:border-2 [&_aside.callout]:p-6 [&_aside.callout-accent]:border-accent/30 [&_aside.callout-accent]:bg-accent/5 [&_aside.callout-primary]:border-primary/30 [&_aside.callout-primary]:bg-primary/5">
        <Content />
      </div>

      {post.data.keySources && (
        <div class="mt-16 pt-8 border-t border-border">
          <p class="text-xs uppercase tracking-widest text-muted-foreground mb-2">Key Sources</p>
          <p class="text-sm text-foreground/80 leading-relaxed">{post.data.keySources}</p>
        </div>
      )}
    </div>
  </article>
</SiteLayout>
