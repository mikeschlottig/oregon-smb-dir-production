---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { blogCategories, getBlogCategory } from "@/data/blogCategories";
import { pageCount, pageSlice as slicePage } from "@/lib/paginate";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Pagination from "@/components/Pagination.astro";
import { getCollection } from "astro:content";
import { trail, visibleTrail, breadcrumbListSchema } from "@/lib/breadcrumbs";
import { ArrowRight, Calendar, Clock } from "lucide-react";

export async function getStaticPaths() {
  const PER_PAGE = 12;
  const slugifyCategory = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  const posts = await getCollection("blog");
  const byCat: Record<string, typeof posts> = {};
  for (const p of posts) {
    const k = p.data.category;
    (byCat[k] ||= []).push(p);
  }
  const paths = [];
  for (const [cat, list] of Object.entries(byCat)) {
    list.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
    const totalPages = pageCount(list.length, PER_PAGE);
    for (let i = 2; i <= totalPages; i++) {
      paths.push({
        params: { category: slugifyCategory(cat), page: String(i) },
        props: {
          categoryName: cat,
          currentPage: i,
          totalPages,
          pageSlice: slicePage(list, i, PER_PAGE),
        },
      });
    }
  }
  return paths;
}

const { categoryName, currentPage, totalPages, pageSlice } = Astro.props;
const slugifyCategory = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const baseUrl = `/blog/category/${slugifyCategory(categoryName)}/`;

const formatDate = (iso: string) => {
  if (!iso) return "";
  const d = new Date(iso + "T00:00:00");
  if (isNaN(d.getTime())) return iso;
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
};

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const categorySlug = slugifyCategory(categoryName);
const categoryInfo = getBlogCategory(categoryName);

const crumbs = trail([
    { name: "Blog", path: "/blog/" },
    { name: categoryName, path: `/blog/category/${categorySlug}/` },
    { name: `Page ${currentPage}` },
]);

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${categoryName} — Page ${currentPage}`,
    url: `${siteUrl}/blog/category/${categorySlug}/page/${currentPage}/`,
  },
  breadcrumbListSchema(crumbs, siteUrl),
];
---
<SiteLayout title={`${categoryName} — Page ${currentPage}`} schemas={schemas}>
  <section class="bg-muted pt-32 pb-14 px-4 border-b border-border">
    <div class="container mx-auto max-w-4xl text-center">
      <Breadcrumbs crumbs={visibleTrail(crumbs)} class="mb-6" />
      <p class="text-accent text-sm uppercase tracking-widest mb-3">Category · Page {currentPage}</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold mb-2">{categoryName}</h1>
      {categoryInfo && (
        <p class="mt-5 text-muted-foreground text-left md:text-center max-w-3xl mx-auto leading-relaxed">
          {categoryInfo.description}
        </p>
      )}
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {pageSlice.map((p) => (
        <a
          href={`/blog/${p.id}/`}
          class="group bg-card border border-border rounded-xl p-7 hover:shadow-elegant hover:-translate-y-1 transition-all duration-300 flex flex-col"
        >
          <div class="flex items-center gap-3 text-xs text-muted-foreground mb-4">
            <span class="bg-muted px-2.5 py-1 rounded-full text-accent font-medium uppercase tracking-wider">
              {p.data.category}
            </span>
            {p.data.city && <span>· {p.data.city}</span>}
          </div>
          <h2 class="font-serif text-2xl font-bold leading-snug text-foreground group-hover:text-primary transition-colors mb-3">
            {p.data.title}
          </h2>
          <p class="text-muted-foreground text-sm leading-relaxed flex-1">{p.data.excerpt}</p>
          <div class="mt-5 pt-5 border-t border-border flex items-center justify-between text-xs text-muted-foreground">
            <span class="inline-flex items-center gap-1.5"><Calendar className="w-3.5 h-3.5" />{formatDate(p.data.date)}</span>
            <span class="inline-flex items-center gap-1.5"><Clock className="w-3.5 h-3.5" />{p.data.readTime}</span>
          </div>
          <span class="mt-4 inline-flex items-center gap-2 text-primary font-medium text-sm group-hover:gap-3 transition-all">
            Read article <ArrowRight className="w-4 h-4" />
          </span>
        </a>
      ))}
    </div>

    <Pagination baseUrl={baseUrl} currentPage={currentPage} totalPages={totalPages} />
  </section>
  <section class="container mx-auto px-4 pb-16">
    <h2 class="font-serif text-2xl font-bold mb-5">Other categories</h2>
    <div class="flex flex-wrap gap-3">
      {blogCategories
        .filter((c) => c.name !== categoryName)
        .map((c) => (
          <a
            href={`/blog/category/${slugifyCategory(c.name)}/`}
            class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-muted text-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
          >
            {c.name}
          </a>
        ))}
    </div>
  </section>
</SiteLayout>
