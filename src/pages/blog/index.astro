---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Pagination from "@/components/Pagination.astro";
import { getCollection } from "astro:content";
import { breadcrumbSchema } from "@/lib/schema";
import { ArrowRight, Calendar, Clock } from "lucide-react";

const PER_PAGE = 12;

const allPosts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const totalPages = Math.max(1, Math.ceil(allPosts.length / PER_PAGE));
const pageSlice = allPosts.slice(0, PER_PAGE);

const categoryCounts = allPosts.reduce<Record<string, number>>((acc, p) => {
  acc[p.data.category] = (acc[p.data.category] || 0) + 1;
  return acc;
}, {});
const categories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);
const slugifyCategory = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

const formatDate = (iso: string) => {
  if (!iso) return "";
  const d = new Date(iso + "T00:00:00");
  if (isNaN(d.getTime())) return iso;
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
};

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Blog — Oregon SMB Directory",
    url: `${siteUrl}/blog`,
    description: "Local guides, business advice, and on-the-ground reporting from every stop along Oregon's most-traveled corridor.",
  },
  breadcrumbSchema([
    { name: "Home", url: siteUrl },
    { name: "Blog", url: `${siteUrl}/blog` },
  ]),
];
---
<SiteLayout title="Stories from the I-5 — Oregon SMB Directory Blog" schemas={schemas}>
  <section class="bg-muted pt-32 pb-14 px-4 border-b border-border">
    <div class="container mx-auto max-w-4xl text-center">
      <p class="text-accent text-sm uppercase tracking-widest mb-3">The Blog</p>
      <h1 class="font-serif text-5xl md:text-6xl font-bold mb-4">Stories from the I-5</h1>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Local guides, business advice, and on-the-ground reporting from every stop along Oregon's most-traveled corridor.
      </p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-10">
    <div class="flex flex-wrap gap-2 justify-center">
      <a href="/blog/" class="px-3 py-1.5 rounded-full text-xs uppercase tracking-wider bg-primary text-primary-foreground">All ({allPosts.length})</a>
      {categories.map(([cat, n]) => (
        <a
          href={`/blog/category/${slugifyCategory(cat)}/`}
          class="px-3 py-1.5 rounded-full text-xs uppercase tracking-wider bg-muted text-muted-foreground hover:bg-accent/10 hover:text-accent transition-colors"
        >
          {cat} ({n})
        </a>
      ))}
    </div>
  </section>

  <section class="container mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {pageSlice.map((p) => (
        <a
          href={`/blog/${p.id}/`}
          class="group bg-card border border-border rounded-xl p-7 hover:shadow-elegant hover:-translate-y-1 transition-all duration-300 flex flex-col"
        >
          <div class="flex items-center gap-3 text-xs text-muted-foreground mb-4">
            <span class="bg-muted px-2.5 py-1 rounded-full text-accent font-medium uppercase tracking-wider">
              {p.data.category}
            </span>
            {p.data.city && <span>· {p.data.city}</span>}
          </div>
          <h2 class="font-serif text-2xl font-bold leading-snug text-foreground group-hover:text-primary transition-colors mb-3">
            {p.data.title}
          </h2>
          <p class="text-muted-foreground text-sm leading-relaxed flex-1">{p.data.excerpt}</p>
          <div class="mt-5 pt-5 border-t border-border flex items-center justify-between text-xs text-muted-foreground">
            <span class="inline-flex items-center gap-1.5"><Calendar className="w-3.5 h-3.5" />{formatDate(p.data.date)}</span>
            <span class="inline-flex items-center gap-1.5"><Clock className="w-3.5 h-3.5" />{p.data.readTime}</span>
          </div>
          <span class="mt-4 inline-flex items-center gap-2 text-primary font-medium text-sm group-hover:gap-3 transition-all">
            Read article <ArrowRight className="w-4 h-4" />
          </span>
        </a>
      ))}
    </div>

    <Pagination baseUrl="/blog/" currentPage={1} totalPages={totalPages} />
  </section>
</SiteLayout>
