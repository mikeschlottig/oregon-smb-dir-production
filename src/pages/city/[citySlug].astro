---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { IndustryCard } from "@/components/cards/IndustryCard";
import { cities } from "@/data/cities";
import { industries } from "@/data/industries";
import { ChevronRight, MapPin } from "lucide-react";

export async function getStaticPaths() {
  return cities.map((city) => ({
    params: { citySlug: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const cityImageSrc = (city.image as any).src ?? city.image;
const title = `${city.name}, Oregon — Local Business Directory`;
const description = city.description;
---
<SiteLayout title={title} description={description}>
  <section class="relative h-80 md:h-[420px]">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url(${cityImageSrc})`}
    />
    <div class="absolute inset-0 bg-gradient-to-b from-foreground/40 via-foreground/30 to-foreground/80" />
    <div class="relative z-10 h-full flex flex-col justify-end px-4 pb-10 container mx-auto pt-20">
      <nav class="flex items-center gap-2 text-white/70 text-sm mb-4">
        <a href="/" class="hover:text-white">Home</a>
        <ChevronRight className="w-4 h-4" />
        <span class="text-white">{city.name}</span>
      </nav>
      <p class="flex items-center gap-2 text-gold text-sm mb-2 uppercase tracking-widest">
        <MapPin className="w-4 h-4" /> Oregon I-5 Corridor
      </p>
      <h1 class="font-serif text-4xl md:text-6xl font-bold text-white mb-2">{city.name}</h1>
      <p class="text-white/85 text-lg max-w-2xl">{city.description}</p>
    </div>
  </section>

  <section class="container mx-auto px-4 pt-16 pb-20">
    <div class="text-center mb-12">
      <h2 class="font-serif text-3xl md:text-4xl font-bold mb-3">Browse by Industry</h2>
      <p class="text-muted-foreground text-lg">
        Find trusted local businesses in {city.name} across all major service categories.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {industries.map((i) => <IndustryCard industry={i} citySlug={city.slug} />)}
    </div>
  </section>
</SiteLayout>
