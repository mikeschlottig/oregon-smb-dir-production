---
import { fitTitle, fitDescription } from "@/lib/seo-text";
import { publisher } from "@/data/publisher";
import SiteLayout from "@/layouts/SiteLayout.astro";
import TldrCard from "@/components/TldrCard.astro";
import SeoTextBlock from "@/components/SeoTextBlock.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import { IndustryCard } from "@/components/cards/IndustryCard";
import { cities } from "@/data/cities";
import { industries } from "@/data/industries";
import { getBusinesses } from "@/data/businesses";
import { generateCitySeoContent } from "@/lib/seo-content";
import { cityPageSchema } from "@/lib/schema";
import { trail, visibleTrail, breadcrumbListSchema } from "@/lib/breadcrumbs";
import { getCityHubRelatedLinks } from "@/lib/link-graph";
import { ChevronRight } from "lucide-react";

export async function getStaticPaths() {
  return cities.map((city) => ({
    params: { citySlug: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;

// Calculate real stats for TldrCard
const cityIndustriesWithListings = industries.filter(ind => 
  getBusinesses(city.slug, ind.slug).length > 0
);
const totalListings = cityIndustriesWithListings.reduce(
  (sum, ind) => sum + getBusinesses(city.slug, ind.slug).length, 
  0
);

const fmt = new Intl.NumberFormat("en-US");
/** "over 1,000" for 1,087; exact below 100. Counted at build time, never typed (STANDARDS.md §13). */
const countWords = totalListings >= 100 ? `over ${fmt.format(Math.floor((totalListings - 1) / 100) * 100)}` : fmt.format(totalListings);
const where = city.county ? `${city.county} County` : city.region;

// Title, H1, H2 and industry headings: Mike's Bend audit, 2026-11-21 (Documents/11-20/bend.txt).
const title = fitTitle([
  `${city.name}, Oregon — Find Local Businesses in ${city.name}, OR`,
  `${city.name}, Oregon — Local Businesses in ${city.name}, OR`,
  `${city.name}, OR — Local Business Directory`,
]);
const h1 = `${city.name}, Oregon: Search ${countWords} Local Businesses in ${where}`;
const description = fitDescription([
  `Find local businesses in ${city.name}, OR: ${fmt.format(totalListings)} listings across ${cityIndustriesWithListings.length} industries in ${where}.`,
  `Search by industry or service category, with phone numbers, websites and maps.`,
  `Search by industry or service category.`,
]);

const tldrStats = [
  { value: cityIndustriesWithListings.length.toString(), label: "Industries" },
  { value: totalListings.toString(), label: "Listings" },
  { value: city.population, label: "Population" },
  ...(city.county ? [{ value: `${city.county} Co.`, label: "County" }] : [])
];

// Generate SEO content for city page
const allCityBusinesses = cityIndustriesWithListings.flatMap(ind => getBusinesses(city.slug, ind.slug));
const seoContent = generateCitySeoContent(city, cityIndustriesWithListings, allCityBusinesses);

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const crumbs = trail([
  { name: "Cities", path: "/city/" },
  { name: city.name },
]);
const schemas = [
  ...cityPageSchema(city, cityIndustriesWithListings, siteUrl),
  breadcrumbListSchema(crumbs, siteUrl),
];

// Compute related links for city hub page
const relatedLinks = getCityHubRelatedLinks({
  citySlug: city.slug,
  baseUrl: siteUrl,
});
---
<SiteLayout title={title} description={description} schemas={schemas} city={city.name} pageType="city">
  <TldrCard
    breadcrumb={visibleTrail(crumbs)}
    eyebrow={city.region}
    title={h1}
    tagline={city.tagline}
    stats={tldrStats}
    county={city.county}
  />

  <section class="container mx-auto px-4 pt-16 pb-20">
    <div class="text-center mb-12">
      <h2 class="font-serif text-3xl md:text-4xl font-bold mb-3">Browse {city.name} Businesses by Industry</h2>
      <p class="text-muted-foreground text-lg">
        {fmt.format(totalListings)} local businesses in {city.name}, grouped into {cityIndustriesWithListings.length} industries.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {/* Only industries with listings here: an empty industry page is noindex, so its card was a dead end. */}
      {cityIndustriesWithListings.map((i) => <IndustryCard industry={i} citySlug={city.slug} cityName={city.name} />)}
    </div>
  </section>

  <!-- SEO Text Block -->
  <SeoTextBlock title={`About ${city.name}, Oregon`} html={seoContent} />

  <!-- Related Links (automatic internal linking) -->
  <RelatedLinks links={relatedLinks} heading="Related" />
</SiteLayout>
