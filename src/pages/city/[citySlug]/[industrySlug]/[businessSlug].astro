---
import SiteLayout from "@/layouts/SiteLayout.astro";
import TldrCard from "@/components/TldrCard.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import { cities } from "@/data/cities";
import { industries } from "@/data/industries";
import {
  getBusinesses,
  getBusinessPathSlug,
  parseLatLng,
} from "@/data/businesses";

import { hasDedicatedPage } from "@/data/dedicatedPages";
import { serviceCategories } from "@/data/serviceCategories";
import { qualifyBusinessForService } from "@/data/serviceSelectionPolicies";
import { businessSchema } from "@/lib/schema";
import { trail, visibleTrail, breadcrumbListSchema } from "@/lib/breadcrumbs";
import { getBusinessRelatedLinks } from "@/lib/link-graph";
import {
  ExternalLink,
  Globe,
  MapPin,
  Phone,
  Star,
  ArrowLeft,
  Building2,
} from "lucide-react";

export async function getStaticPaths() {
  const paths: any[] = [];
  for (const city of cities) {
    for (const industry of industries) {
      const businesses = getBusinesses(city.slug, industry.slug);
      for (const business of businesses) {
        const businessSlug = getBusinessPathSlug(city.slug, industry.slug, business);
        // A hand-written page already owns this URL; generating it here too would
        // define the same route twice. See src/data/dedicatedPages.ts.
        if (hasDedicatedPage(city.slug, industry.slug, businessSlug)) continue;
        paths.push({
          params: { citySlug: city.slug, industrySlug: industry.slug, businessSlug },
          props: { city, industry, business },
        });
      }
    }
  }
  return paths;
}

const { city, industry, business } = Astro.props;

const coords = parseLatLng(business.googleUrl);
const mapsDirections = coords
  ? `https://www.google.com/maps/dir/?api=1&destination=${coords.lat},${coords.lng}`
  : business.googleUrl ??
    `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
      `${business.title} ${business.address ?? city.name}`,
    )}`;

const embedSrc = coords
  ? `https://www.google.com/maps?q=${coords.lat},${coords.lng}&hl=en&z=15&output=embed`
  : `https://www.google.com/maps?q=${encodeURIComponent(
      `${business.title} ${business.address ?? city.name}`,
    )}&hl=en&z=15&output=embed`;

const related = getBusinesses(city.slug, industry.slug)
  .filter((b) => b.title !== business.title)
  .slice(0, 4);

const title = `${business.title} — ${industry.name} in ${city.name}, OR`;
const description = `${business.title} is a ${
  business.category?.toLowerCase() ?? industry.name.toLowerCase()
} serving ${city.name}, Oregon. ${industry.description}.`;

const isTopRated = typeof business.rating === "number" && business.rating >= 4.8;
const observationDate = business.ratingObservation
  ? new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric", timeZone: "UTC" }).format(
      new Date(business.ratingObservation.observedAt),
    )
  : null;
const verificationLabel = business.verification
  ? business.verification.status.replaceAll("_", " ")
  : "Source observed";
const badge = `${verificationLabel}${isTopRated ? " · 4.8+ source rating" : ""}`;

// Stats for TldrCard
const stats = [
  { value: typeof business.rating === "number" ? business.rating.toFixed(1) : "N/A", label: "Rating" },
  { value: typeof business.reviews === "number" ? business.reviews.toLocaleString() : "N/A", label: "Reviews" },
  { value: verificationLabel, label: "Record status" }
];

/**
 * Where this listing sits among its peers, stated in numbers drawn from this city and
 * industry. A business page is otherwise a name, an address and a generated sentence —
 * legitimately short, but short enough that the class as a whole sat within a few words
 * of the content floor. This is the one thing a directory can say about a listing that
 * no other page on the site says.
 */
const peers = getBusinesses(city.slug, industry.slug);
const ratedPeers = peers.filter(
  (b): b is typeof b & { rating: number } => typeof b.rating === "number"
);
const sameCategory = business.category
  ? peers.filter((b) => b.category === business.category)
  : [];
const betterRated =
  typeof business.rating === "number"
    ? ratedPeers.filter((b) => b.rating > business.rating).length
    : null;

const peerContext = [
  `${business.title} is one of ${peers.length} ${industry.name.toLowerCase()} record${peers.length === 1 ? "" : "s"} the directory holds for ${city.name}, ${city.county} County.`,
  business.category && sameCategory.length > 1
    ? `${sameCategory.length} of those share the same source-observed provider category, ${business.category.toLowerCase()}.`
    : business.category
      ? `It is the only ${city.name} record in this industry filed under ${business.category.toLowerCase()}.`
      : "",
  typeof business.rating === "number" && ratedPeers.length > 1
    ? `${ratedPeers.length} of the ${peers.length} carry a rating that clears the publication gate; ${betterRated} of them rate higher than this one${observationDate ? `, measured against source records observed through ${observationDate}` : ""}.`
    : `Ratings are published only where the value, review count, observation date and record identity agree with the source evidence.`,
  `Details here are source-observed rather than owner-confirmed, so confirm hours, service area and pricing with the business before relying on them.`,
]
  .filter(Boolean)
  .join(" ");

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const businessPath = getBusinessPathSlug(city.slug, industry.slug, business);
const crumbs = trail([
  { name: "Cities", path: "/city/" },
  { name: city.name, path: `/city/${city.slug}/` },
  { name: industry.name, path: `/city/${city.slug}/${industry.slug}/` },
  { name: business.title },
]);
const schemas = [
  businessSchema(business, city, industry, siteUrl),
  breadcrumbListSchema(crumbs, siteUrl),
];

// Colloquial search term map for consumer intent
const colloquialMap: Record<string, string[]> = {
  roofing: ["roofer", "roofers", "roofing contractor", "roof repair", "roof replacement"],
  plumbing: ["plumber", "plumbers", "drain cleaning"],
  electrical: ["electrician", "electricians", "electrical contractor"],
  hvac: ["heating and cooling", "ac repair", "hvac technician"],
  "real-estate-agents": ["realtor", "realtors", "real estate agent", "real estate agents"],
  auto_repair: ["mechanic", "mechanics", "auto repair"],
  dentists: ["dentist", "dentists", "dental care"],
  chiropractors: ["chiropractor", "chiropractors"],
  veterinarians: ["vet", "veterinarian", "animal hospital"],
  landscaping: ["landscaper", "landscapers", "lawn care"],
};

const matchingServices = serviceCategories.filter((cat) =>
  cat.industrySlug === industry.slug && qualifyBusinessForService(business, cat)
);
const serviceSynonyms = Array.from(
  new Set([
    ...(business.category ? [business.category.toLowerCase()] : []),
    ...matchingServices.flatMap((s) => [
      s.displayName.toLowerCase(),
      s.pluralName.toLowerCase(),
      ...s.matchTerms,
      ...(colloquialMap[s.slug] || []),
    ]),
  ])
);

// Compute related links for this business page
const relatedLinks = getBusinessRelatedLinks({
  citySlug: city.slug,
  industrySlug: industry.slug,
  businessSlug: businessPath,
  businesses: getBusinesses(city.slug, industry.slug),
  baseUrl: siteUrl,
});
---
<SiteLayout
  title={title}
  description={description}
  schemas={schemas}
  city={city.name}
  industry={industry.name}
  pageType="business"
>
  <!-- Dark TLDR Header with TldrCard -->
  <TldrCard
    breadcrumb={visibleTrail(crumbs)}
    eyebrow={`${business.category || industry.name} in ${city.name}, OR`}
    title={business.title}
    tagline={`${business.category || industry.name} in ${city.name}, Oregon`}
    stats={stats}
    badge={badge}
  />

  <section class="container mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 space-y-8">
      <div class="rounded-xl overflow-hidden border border-border shadow-sm bg-muted">
        <iframe
          title={`Map of ${business.title}`}
          src={embedSrc}
          width="100%"
          height="360"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block w-full"
        />
        <div class="p-4 flex flex-wrap items-center justify-between gap-3 bg-card">
          <p class="text-sm text-muted-foreground flex items-center gap-2">
            <MapPin className="w-4 h-4 text-accent" />
            {business.address ?? `${city.name}, OR`}
          </p>
          <a
            href={mapsDirections}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-1.5 bg-primary text-primary-foreground text-sm font-medium px-4 py-2 rounded hover:bg-primary/90 transition-colors"
          >
            Open in Google Maps <ExternalLink className="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <div>
        <h2 class="font-serif text-2xl font-bold mb-3">About {business.title}</h2>
        <p class="text-muted-foreground leading-relaxed">
          {business.title} is listed as a {business.category?.toLowerCase() ?? industry.name.toLowerCase()} serving the {city.name} area. {industry.description}. {typeof business.rating === "number"
            ? typeof business.reviews === "number"
              ? `The source record showed a ${business.rating.toFixed(1)}-star rating across ${business.reviews.toLocaleString()} reviews${observationDate ? ` when observed in ${observationDate}` : ""}.`
              : `The source record showed a ${business.rating.toFixed(1)}-star rating.`
            : "Contact them directly for service details, availability, and quotes."}
        </p>
      </div>

      {matchingServices.length > 0 && (
        <div>
          <h2 class="font-serif text-2xl font-bold mb-3">Specializations &amp; Services</h2>
          <div class="flex flex-wrap gap-2 mb-2">
            {matchingServices.map((s) => (
              <span
                class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium"
                style="background-color: var(--c-sky); color: var(--c-pine);"
              >
                {s.displayName}
              </span>
            ))}
          </div>
          <p class="text-xs text-muted-foreground">
            Search keywords: {serviceSynonyms.slice(0, 10).join(", ")}.
          </p>
        </div>
      )}

      <div>
        <h2 class="font-serif text-2xl font-bold mb-3">How this listing sits in {city.name}</h2>
        <p class="text-muted-foreground leading-relaxed">
          {peerContext}
        </p>
      </div>
    </div>

    <aside class="space-y-6">
      <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
        <h3 class="font-serif text-lg font-semibold mb-4">Contact</h3>
        <ul class="space-y-3 text-sm">
          {business.address && (
            <li class="flex items-start gap-3">
              <MapPin className="w-4 h-4 mt-0.5 text-accent flex-shrink-0" />
              <span class="text-muted-foreground">{business.address}</span>
            </li>
          )}
          {business.phone && (
            <li class="flex items-center gap-3">
              <Phone className="w-4 h-4 text-accent flex-shrink-0" />
              <a href={`tel:${business.phone}`} class="text-foreground hover:text-accent">
                {business.phone}
              </a>
            </li>
          )}
          {business.website && business.websiteStatus === "confirmed" && (
            <li class="flex items-center gap-3">
              <Globe className="w-4 h-4 text-accent flex-shrink-0" />
              <a
                href={business.website}
                target="_blank"
                rel="noreferrer"
                class="text-foreground hover:text-accent break-all"
              >
                {business.website.replace(/^https?:\/\//, "").replace(/\/$/, "")}
              </a>
            </li>
          )}
          {!business.website && business.websiteStatus === "unconfirmed" && (
            <li class="flex items-center gap-3">
              <Globe className="w-4 h-4 text-accent flex-shrink-0" />
              <span class="text-muted-foreground">Website not confirmed</span>
            </li>
          )}
          {business.websiteStatus === "quarantined" && (
            <li class="flex items-center gap-3">
              <Globe className="w-4 h-4 text-accent flex-shrink-0" />
              <span class="text-muted-foreground">Website withheld pending review</span>
            </li>
          )}
          {business.category && (
            <li class="flex items-center gap-3">
              <Building2 className="w-4 h-4 text-accent flex-shrink-0" />
              <span class="text-muted-foreground">{business.category}</span>
            </li>
          )}
        </ul>

        <div class="mt-5 pt-5 border-t border-border space-y-2">
          <a
            href={mapsDirections}
            target="_blank"
            rel="noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground text-sm font-medium px-4 py-2.5 rounded hover:bg-primary/90 transition-colors"
          >
            Get Directions <ExternalLink className="w-3.5 h-3.5" />
          </a>
          {business.website && business.websiteStatus === "confirmed" && (
            <a
              href={business.website}
              target="_blank"
              rel="noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 border border-border text-sm font-medium px-4 py-2.5 rounded hover:bg-muted transition-colors"
            >
              Visit Website <ExternalLink className="w-3.5 h-3.5" />
            </a>
          )}
          {business.phone && (
            <a
              href={`tel:${business.phone}`}
              class="w-full inline-flex items-center justify-center gap-2 border border-border text-sm font-medium px-4 py-2.5 rounded hover:bg-muted transition-colors"
            >
              <Phone className="w-3.5 h-3.5" /> Call Now
            </a>
          )}
        </div>
      </div>

      <div class="bg-card border border-border rounded-xl p-6 shadow-sm text-sm">
        <h3 class="font-serif text-lg font-semibold mb-3">Data provenance</h3>
        <p class="text-muted-foreground leading-relaxed">
          This is a source-observed directory record, not an owner-confirmed profile unless a specific verification event appears above.
          {business.ratingObservation && (
            <> Rating evidence is tied to provider record <code>{business.ratingObservation.sourceRecordId}</code> and was observed {observationDate}.</>
          )}
        </p>
        <a href="/contact/?topic=listing-correction" class="inline-flex mt-3 text-accent hover:underline">
          Request a correction
        </a>
      </div>

      {related.length > 0 && (
        <div class="bg-card border border-border rounded-xl p-6 shadow-sm" data-pagefind-ignore="all">
          <h3 class="font-serif text-lg font-semibold mb-4">
            More {industry.name} in {city.name}
          </h3>
          <ul class="space-y-3">
            {related.map((b) => (
              <li>
                <a
                  href={`/city/${city.slug}/${industry.slug}/${getBusinessPathSlug(city.slug, industry.slug, b)}/`}
                  class="flex items-center justify-between gap-2 text-sm group"
                >
                  <span class="text-foreground group-hover:text-accent transition-colors">
                    {b.title}
                  </span>
                  {typeof b.rating === "number" && (
                    <span class="flex items-center gap-1 text-muted-foreground text-xs flex-shrink-0">
                      <Star className="w-3 h-3 fill-gold text-gold" />
                      {b.rating.toFixed(1)}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
          <a
            href={`/city/${city.slug}/${industry.slug}/`}
            class="inline-flex items-center gap-1 text-sm text-accent mt-4 hover:underline"
          >
            <ArrowLeft className="w-3.5 h-3.5" /> Back to all listings
          </a>
        </div>
      )}
    </aside>
  </section>

  <!--
    No FAQ block here by design. The questions this page used to carry were generated
    from the city-industry aggregate, not from this business, so every listing in the
    same city and industry shipped the identical four answers — 9,598 pages sharing
    143 answer sets, each wrapped in its own FAQPage. The aggregate questions are
    answered once, on the industry page linked below.
  -->
  <section class="container mx-auto px-4 py-12 border-t" style="border-color: var(--c-border);">
    <p class="max-w-3xl text-sm leading-relaxed" style="color: var(--c-sage);">
      Looking for how {business.title} compares with other {industry.name.toLowerCase()} in
      {city.name}? The
      <a href={`/city/${city.slug}/${industry.slug}/`} class="underline" style="color: var(--c-river);">
        {industry.name} in {city.name}
      </a>
      page carries the full listing set, the rating distribution, and the questions that
      apply across the whole category.
    </p>
  </section>

  <!-- Related Links (automatic internal linking) -->
  <RelatedLinks links={relatedLinks} heading="Related" />
</SiteLayout>
