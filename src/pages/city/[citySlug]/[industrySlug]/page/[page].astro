---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import BusinessFilterGrid from "@/components/BusinessFilterGrid";
import Pagination from "@/components/Pagination.astro";
import { cities } from "@/data/cities";
import { industries } from "@/data/industries";
import { getBusinesses } from "@/data/businesses";
import { industryPageSchema } from "@/lib/schema";
import { trail, visibleTrail, breadcrumbListSchema } from "@/lib/breadcrumbs";
import { pageCount, pageRanges, pageSlice as slicePage } from "@/lib/paginate";

export async function getStaticPaths() {
  const paths: any[] = [];
  for (const city of cities) {
    for (const industry of industries) {
      const all = getBusinesses(city.slug, industry.slug);
      const totalPages = pageCount(all.length);
      for (let p = 2; p <= totalPages; p++) {
        paths.push({
          params: { citySlug: city.slug, industrySlug: industry.slug, page: String(p) },
          props: { city, industry, currentPage: p, totalPages },
        });
      }
    }
  }
  return paths;
}

const { city, industry, currentPage, totalPages } = Astro.props;
const businesses = getBusinesses(city.slug, industry.slug);
const pageSlice = slicePage(businesses, currentPage);
const range = pageRanges(businesses.length).find((r) => r.page === currentPage)!;
const baseUrl = `/city/${city.slug}/${industry.slug}/`;

const title = `${industry.name} in ${city.name}, Oregon — Page ${currentPage}`;
const description = `${industry.description}. Browse ${businesses.length} source-observed business records serving ${city.name} (page ${currentPage} of ${totalPages}).`;

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const crumbs = trail([
  { name: city.name, path: `/city/${city.slug}/` },
  { name: industry.name, path: `/city/${city.slug}/${industry.slug}/` },
  { name: `Page ${currentPage}` },
]);
const schemas = [
  ...industryPageSchema(city, industry, pageSlice, siteUrl, `/city/${city.slug}/${industry.slug}/page/${currentPage}/`),
  breadcrumbListSchema(crumbs, siteUrl),
];
---
<SiteLayout title={title} description={description} schemas={schemas}>
  <section class="bg-muted pt-32 pb-12 px-4 border-b border-border">
    <div class="container mx-auto">
      <Breadcrumbs crumbs={visibleTrail(crumbs)} class="mb-6" />
      <p class="text-accent text-sm uppercase tracking-widest mb-2">{city.name}</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold mb-3">
        {industry.name} in {city.name} — Page {currentPage}
      </h1>
      <p class="text-muted-foreground text-lg max-w-2xl">
        Showing results {range.start + 1}–{range.end} of {businesses.length} business record{businesses.length === 1 ? "" : "s"}.
      </p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <BusinessFilterGrid
      client:load
      businesses={businesses}
      pageSlice={pageSlice}
      citySlug={city.slug}
      industrySlug={industry.slug}
      industryName={industry.name}
    />
    <Pagination baseUrl={baseUrl} currentPage={currentPage} totalPages={totalPages} />
  </section>
</SiteLayout>
