---
import SiteLayout from "@/layouts/SiteLayout.astro";
import BusinessFilterGrid from "@/components/BusinessFilterGrid";
import Pagination from "@/components/Pagination.astro";
import { cities } from "@/data/cities";
import { industries } from "@/data/industries";
import { getBusinesses } from "@/data/businesses";
import { industryPageSchema, breadcrumbSchema } from "@/lib/schema";
import { ChevronRight } from "lucide-react";

const PER_PAGE = 15;

export async function getStaticPaths() {
  const PER_PAGE = 15;
  const paths: any[] = [];
  for (const city of cities) {
    for (const industry of industries) {
      const all = getBusinesses(city.slug, industry.slug);
      const totalPages = Math.ceil(all.length / PER_PAGE);
      for (let p = 2; p <= totalPages; p++) {
        paths.push({
          params: { citySlug: city.slug, industrySlug: industry.slug, page: String(p) },
          props: { city, industry, currentPage: p, totalPages },
        });
      }
    }
  }
  return paths;
}

const { city, industry, currentPage, totalPages } = Astro.props;
const businesses = getBusinesses(city.slug, industry.slug);
const pageSlice = businesses.slice((currentPage - 1) * PER_PAGE, currentPage * PER_PAGE);
const baseUrl = `/city/${city.slug}/${industry.slug}/`;

const title = `${industry.name} in ${city.name}, Oregon — Page ${currentPage}`;
const description = `${industry.description}. Browse ${businesses.length} verified providers serving ${city.name} (page ${currentPage} of ${totalPages}).`;

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const breadcrumbItems = [
  { name: "Home", url: siteUrl },
  { name: city.name, url: `${siteUrl}/city/${city.slug}` },
  { name: industry.name, url: `${siteUrl}/city/${city.slug}/${industry.slug}` },
  { name: `Page ${currentPage}`, url: `${siteUrl}/city/${city.slug}/${industry.slug}/${currentPage}/` },
];
const schemas = [
  ...industryPageSchema(city, industry, pageSlice, siteUrl),
  breadcrumbSchema(breadcrumbItems),
];
---
<SiteLayout title={title} description={description} schemas={schemas}>
  <section class="bg-muted pt-32 pb-12 px-4 border-b border-border">
    <div class="container mx-auto">
      <nav class="flex items-center flex-wrap gap-2 text-muted-foreground text-sm mb-4">
        <a href="/" class="hover:text-foreground">Home</a>
        <ChevronRight className="w-4 h-4" />
        <a href={`/city/${city.slug}`} class="hover:text-foreground">{city.name}</a>
        <ChevronRight className="w-4 h-4" />
        <a href={baseUrl} class="hover:text-foreground">{industry.name}</a>
        <ChevronRight className="w-4 h-4" />
        <span class="text-foreground">Page {currentPage}</span>
      </nav>
      <p class="text-accent text-sm uppercase tracking-widest mb-2">{city.name}</p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold mb-3">
        {industry.name} in {city.name} — Page {currentPage}
      </h1>
      <p class="text-muted-foreground text-lg max-w-2xl">
        Showing results {(currentPage - 1) * PER_PAGE + 1}–{(currentPage - 1) * PER_PAGE + pageSlice.length} of {businesses.length} verified provider{businesses.length === 1 ? "" : "s"}.
      </p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <BusinessFilterGrid
      client:load
      businesses={businesses}
      pageSlice={pageSlice}
      citySlug={city.slug}
      industrySlug={industry.slug}
      industryName={industry.name}
    />
    <Pagination baseUrl={baseUrl} currentPage={currentPage} totalPages={totalPages} />
  </section>
</SiteLayout>
