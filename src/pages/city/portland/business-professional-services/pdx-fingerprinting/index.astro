---
import SiteLayout from "@/layouts/SiteLayout.astro";
import TldrCard from "@/components/TldrCard.astro";
import RelatedLinks from "@/components/RelatedLinks.astro";
import { businessSchema } from "@/lib/schema";
import { trail, visibleTrail, breadcrumbListSchema } from "@/lib/breadcrumbs";
import { getBusinessRelatedLinks } from "@/lib/link-graph";
import { ratingAsOf, ratingLabel } from "@/lib/rating-display";
import { getBusinesses } from "@/data/businesses";
import { cities } from "@/data/cities";
import { industries } from "@/data/industries";
import { ExternalLink, Globe, MapPin, Phone, Star, ArrowLeft, Building2 } from "lucide-react";

const city = cities.find(c => c.slug === "portland")!;
const industry = industries.find(i => i.slug === "business-professional-services")!;
const businesses = getBusinesses("portland", "business-professional-services");
const related = businesses.filter(b => b.slug !== "pdx-fingerprinting").slice(0, 4);

const title = "PDX Fingerprinting — Fingerprinting, Notary & Translation in Portland, OR";
const description = "PDX Fingerprinting offers live scan and ink fingerprinting, FBI background checks, apostille, notary and certified translation from offices in Hillsboro and Lake Oswego, Oregon.";

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const crumbs = trail([
  { name: "Cities", path: "/city/" },
  { name: "Portland", path: "/city/portland/" },
  { name: "Business & Professional Services", path: "/city/portland/business-professional-services/" },
  { name: "PDX Fingerprinting" },
]);

// Rating, verification and website come from the gated listing record, so this page
// shows exactly what the publication gates allow and cannot drift from the data.
const record = businesses.find(b => b.slug === "pdx-fingerprinting")!;
const isVerified = record.verification != null;
const hasRating = typeof record.rating === "number" && typeof record.reviews === "number";
const ratingFootnote = hasRating && record.ratingObservation ? ratingAsOf(record.ratingObservation.observedAt) : null;
const websiteConfirmed = Boolean(record.website && record.websiteStatus === "confirmed");

// Both offices, from the owner's submission and pdxfingerprinting.com. The listing record
// carries the Hillsboro office, whose Google Business Profile holds the rating.
const offices = [
  {
    name: "Hillsboro",
    address: "9620 NE Tanasbourne Dr Suite 300, Hillsboro, OR 97124",
    placeId: "ChIJx2sGoRgPlVQRfbbX3Tj32tU",
  },
  {
    name: "Lake Oswego",
    address: "5 Centerpointe Dr Suite 400, Lake Oswego, OR 97035",
    placeId: "ChIJgREz0xJzlVQR1Wg6SuhB_RE",
  },
].map((o) => ({
  ...o,
  embedSrc: `https://www.google.com/maps?q=${encodeURIComponent(`PDX Fingerprinting ${o.address}`)}&hl=en&z=15&output=embed`,
  directions: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`PDX Fingerprinting ${o.address}`)}&query_place_id=${o.placeId}`,
}));

const services = [
  "Live scan & ink card fingerprinting",
  "FBI background checks",
  "FBI & Oregon apostille",
  "Notary & mobile notary",
  "Certified document translation",
  "ATF/NFA, FDLE & FINRA fingerprinting",
  "Mobile fingerprinting",
  "Passport photos",
];

const schemas = [
  businessSchema({
    title: "PDX Fingerprinting",
    address: record.address,
    phone: record.phone,
    email: record.email,
    website: record.website,
    websiteStatus: record.websiteStatus,
    rating: record.rating,
    reviews: record.reviews,
    ratingObservation: record.ratingObservation,
    verification: record.verification,
    category: "Fingerprinting service",
    slug: "pdx-fingerprinting",
  }, city, industry, siteUrl),
  breadcrumbListSchema(crumbs, siteUrl),
];

const relatedLinks = getBusinessRelatedLinks({
  citySlug: "portland",
  industrySlug: "business-professional-services",
  businessSlug: "pdx-fingerprinting",
  businesses,
  baseUrl: siteUrl,
});
---

<SiteLayout title={title} description={description} schemas={schemas}>
  <TldrCard
    breadcrumb={visibleTrail(crumbs)}
    eyebrow="Fingerprinting, Notary & Translation · Portland metro"
    title="PDX Fingerprinting"
    tagline="Fingerprinting, FBI background checks, apostille, notary and certified translation from two offices on Portland's west and south sides."
    stats={[
      { value: hasRating ? `${record.rating!.toFixed(1)} ★${ratingFootnote ? "*" : ""}` : "N/A", label: "Rating" },
      { value: hasRating ? `${record.reviews!.toLocaleString()}${ratingFootnote ? "*" : ""}` : "N/A", label: "Reviews" },
      { value: isVerified ? "Verified" : "Listed", label: "Record status" },
    ]}
    badge={isVerified ? (websiteConfirmed ? "Verified · confirmed website" : "Verified") : "Listed"}
  />

  <section class="container mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 space-y-10 min-w-0">
      <!-- Quotable answer block -->
      <div class="bg-muted/50 border-l-4 border-accent p-6 rounded-r-lg">
        <h2 class="font-serif text-xl font-bold mb-3 text-foreground">Quick answer</h2>
        <p class="text-muted-foreground leading-relaxed" data-quotable="true">
          PDX Fingerprinting provides live scan and ink fingerprinting, FBI background checks, apostille, notary and certified document translation from two Portland-area offices: 9620 NE Tanasbourne Dr, Suite 300, in Hillsboro and 5 Centerpointe Dr, Suite 400, in Lake Oswego. Call (503) 212-0678 or book at pdxfingerprinting.com.
        </p>
      </div>

      <div>
        <h2 class="font-serif text-2xl font-bold mb-4">About PDX Fingerprinting</h2>
        <p class="text-muted-foreground leading-relaxed mb-4">
          PDX Fingerprinting takes ink card and live scan fingerprints on FD-258, SF-87 and FD-1164 cards, and submits prints for FBI background checks directly to the FBI's CJIS Division. The business says FBI results typically come back within 24 to 48 hours, with expedited processing available for an added fee.
        </p>
        <p class="text-muted-foreground leading-relaxed">
          For visa, immigration and overseas employment paperwork, it offers a combined package of FBI background check, FBI apostille and certified translation, so the whole process can be handled in one place.
        </p>
      </div>

      <div>
        <h2 class="font-serif text-2xl font-bold mb-4">Services</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {services.map((service) => (
            <li class="bg-accent/10 text-accent font-medium px-4 py-2.5 rounded-lg text-sm">{service}</li>
          ))}
        </ul>
      </div>

      <!-- Source: pdxfingerprinting.com/notary-services/ -->
      <div>
        <h2 class="font-serif text-2xl font-bold mb-4">Notary Services</h2>
        <p class="text-muted-foreground leading-relaxed mb-4">
          PDX Fingerprinting notarizes documents for real estate closings, business contracts, powers of attorney and personal paperwork. The business says its commissioned notaries are available on demand 24/7, and its mobile notary service brings the notary to you.
        </p>
        <p class="text-muted-foreground leading-relaxed">
          A notary confirms the signer's identity with a government-issued ID, personal knowledge, or a credible witness under oath. Documents that commonly need one include mortgage and real estate closing papers, auto loans, powers of attorney, living wills and healthcare proxies, and business agreements.
        </p>
      </div>

      <!-- Source: pdxfingerprinting.com/certified-document-translation-service/ -->
      <div>
        <h2 class="font-serif text-2xl font-bold mb-4">Translation Services</h2>
        <p class="text-muted-foreground leading-relaxed mb-4">
          Certified document translations are prepared by an American Translators Association (ATA)-certified translator. The business says its certified translations are accepted by USCIS, Oregon courts, the Oregon DMV, universities and government agencies.
        </p>
        <p class="text-muted-foreground leading-relaxed">
          Each certified translation includes a signed certification statement with the translator's credentials and contact information, as USCIS requires. Languages include Spanish, Russian, Vietnamese, Chinese, Arabic, Korean and Portuguese. Standard certified translations start at $65 per page, with a 1–3 business day turnaround and same-day service for most documents. Notarization and apostille are available in the same visit.
        </p>
      </div>

      <!-- Offices -->
      <div>
        <h2 class="font-serif text-2xl font-bold mb-4">Offices</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {offices.map((o) => (
            <div class="rounded-xl overflow-hidden border border-border shadow-sm bg-muted">
              <iframe
                title={`Map of PDX Fingerprinting ${o.name}`}
                src={o.embedSrc}
                width="100%"
                height="260"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="block w-full"
              />
              <div class="p-4 space-y-3 bg-card">
                <p class="text-sm text-muted-foreground flex items-start gap-2">
                  <MapPin className="w-4 h-4 mt-0.5 text-accent flex-shrink-0" />
                  <span><strong class="text-foreground">{o.name}</strong><br />{o.address}</span>
                </p>
                <a
                  href={o.directions}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center gap-1.5 bg-primary text-primary-foreground text-sm font-medium px-4 py-2 rounded hover:bg-primary/90 transition-colors"
                >
                  Open in Google Maps <ExternalLink className="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      {hasRating && (
        <p class="text-muted-foreground leading-relaxed">
          The Hillsboro office is rated {ratingLabel(record.rating!, record.reviews)} on its Google Business Profile.
        </p>
      )}
    </div>

    <!-- Sidebar -->
    <aside class="space-y-6 min-w-0">
      <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
        <h3 class="font-serif text-lg font-semibold mb-4">Contact</h3>
        <ul class="space-y-3 text-sm">
          {offices.map((o) => (
            <li class="flex items-start gap-3">
              <MapPin className="w-4 h-4 mt-0.5 text-accent flex-shrink-0" />
              <span class="text-muted-foreground">{o.address}</span>
            </li>
          ))}
          <li class="flex items-center gap-3">
            <Phone className="w-4 h-4 text-accent flex-shrink-0" />
            <a href="tel:5032120678" class="text-foreground hover:text-accent">(503) 212-0678</a>
          </li>
          {websiteConfirmed && (
            <li class="flex items-center gap-3">
              <Globe className="w-4 h-4 text-accent flex-shrink-0" />
              <a href={record.website} target="_blank" rel="noopener" class="text-foreground hover:text-accent break-all">
                pdxfingerprinting.com
              </a>
            </li>
          )}
          <li class="flex items-center gap-3">
            <Building2 className="w-4 h-4 text-accent flex-shrink-0" />
            <span class="text-muted-foreground">Fingerprinting service</span>
          </li>
        </ul>

        <div class="mt-5 pt-5 border-t border-border space-y-2">
          {websiteConfirmed && (
            <a
              href={record.website}
              target="_blank"
              rel="noopener"
              class="w-full inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground text-sm font-medium px-4 py-2.5 rounded hover:bg-primary/90 transition-colors"
            >
              Visit Website <ExternalLink className="w-3.5 h-3.5" />
            </a>
          )}
          <a
            href="tel:5032120678"
            class="w-full inline-flex items-center justify-center gap-2 border border-border text-sm font-medium px-4 py-2.5 rounded hover:bg-muted transition-colors"
          >
            <Phone className="w-3.5 h-3.5" /> Call Now
          </a>
        </div>
      </div>

      {isVerified && (
        <div class="bg-card border border-border rounded-xl p-6 shadow-sm text-sm">
          <h3 class="font-serif text-lg font-semibold mb-3">Data provenance</h3>
          <p class="text-muted-foreground leading-relaxed">Verified listing. {record.verification!.method}</p>
          <a href="/contact/?topic=listing-correction" class="inline-flex mt-3 text-accent hover:underline">
            Request a correction
          </a>
        </div>
      )}

      <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
        <h3 class="font-serif text-lg font-semibold mb-3">Service area</h3>
        <p class="text-sm text-muted-foreground">
          Offices in <strong class="text-foreground">Hillsboro and Lake Oswego</strong>, serving the Portland metro area. Mobile fingerprinting and mobile notary are available.
        </p>
      </div>

      {related.length > 0 && (
        <div class="bg-card border border-border rounded-xl p-6 shadow-sm">
          <h3 class="font-serif text-lg font-semibold mb-4">
            More {industry.name} in {city.name}
          </h3>
          <ul class="space-y-3">
            {related.map((b) => (
              <li>
                <a
                  href={`/city/${city.slug}/${industry.slug}/${b.slug}/`}
                  class="flex items-center justify-between gap-2 text-sm group"
                >
                  <span class="text-foreground group-hover:text-accent transition-colors">
                    {b.title}
                  </span>
                  {typeof b.rating === "number" && (
                    <span class="flex items-center gap-1 text-muted-foreground text-xs flex-shrink-0">
                      <Star className="w-3 h-3 fill-gold text-gold" />
                      {b.rating.toFixed(1)}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
          <a
            href={`/city/${city.slug}/${industry.slug}/`}
            class="inline-flex items-center gap-1 text-sm text-accent mt-4 hover:underline"
          >
            <ArrowLeft className="w-3.5 h-3.5" /> Back to all listings
          </a>
        </div>
      )}
    </aside>
  </section>

  {ratingFootnote && (
    <section class="container mx-auto px-4 pb-8">
      <p class="text-xs text-muted-foreground">{ratingFootnote}</p>
    </section>
  )}

  <!-- Related Links -->
  <RelatedLinks links={relatedLinks} heading="Related" />
</SiteLayout>
