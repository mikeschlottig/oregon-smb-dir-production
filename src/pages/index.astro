---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { Hero } from "@/components/sections/Hero";
import { MarqueeBanner } from "@/components/sections/MarqueeBanner";
import { AboutSection } from "@/components/sections/AboutSection";
import { StatsSection } from "@/components/sections/StatsSection";
import { CityCard } from "@/components/cards/CityCard";
import SearchBar from "@/components/SearchBar.astro";
import { cities } from "@/data/cities";
import { getCollection } from "astro:content";
import { researchReports, bestOfLists } from "@/data/content";
import { websiteSchema } from "@/lib/schema";
import { MapPin, ArrowRight, Calendar } from "lucide-react";

// The newest posts from the MDX blog collection (src/content/blog/), never more than 3.
const LATEST_POSTS = 3;
const latestPosts = (await getCollection("blog"))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, LATEST_POSTS);

const formatDate = (iso: string) => {
  const d = new Date(iso + "T00:00:00");
  return isNaN(d.getTime()) ? iso : d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
};

const featured = {
  bestOf: bestOfLists.length > 0 ? bestOfLists[0] : null,
  report: researchReports.length > 0 ? researchReports[0] : null,
};

export const title = "Oregon Business Directory — Statewide Local Listings";
export const description = "A statewide Oregon business directory organized by regional, city, industry, and service collections.";

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");

const schemas = [
  ...websiteSchema(siteUrl),
];
---
<SiteLayout title={title} description={description} schemas={schemas}>
  <Hero />
  <MarqueeBanner />
  
  <!-- Search Section -->
  <section class="container mx-auto px-4 py-12">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-playfair text-2xl md:text-3xl font-bold mb-6 text-center" style="color: var(--c-pine);">
        Search Oregon Businesses
      </h2>
      <SearchBar />
    </div>
  </section>
  
  <AboutSection />

  <section id="cities" class="container mx-auto px-4 py-20 scroll-mt-20">
    <div class="text-center mb-14">
      <p class="inline-flex items-center gap-2 text-accent text-sm font-medium mb-3 uppercase tracking-widest">
        <MapPin className="w-4 h-4" />
        Explore Oregon
      </p>
      <h2 class="font-serif text-4xl md:text-5xl font-bold mb-4 text-foreground">
        Cities Statewide
      </h2>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Select a city to discover local businesses across 12 industries, from Ashland in the south to Portland in the north, plus Corvallis, Bend, and Klamath Falls.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {cities.map((c) => <CityCard city={c} />)}
    </div>
  </section>

  <StatsSection />

  <section class="container mx-auto px-4 py-20">
    <div class="text-center mb-14">
      <p class="text-accent text-sm font-medium mb-3 uppercase tracking-widest">Editorial</p>
      <h2 class="font-serif text-4xl md:text-5xl font-bold mb-4">From the Newsroom</h2>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Local stories, regional research, and the best businesses across Oregon — curated by our editors.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestPosts.map((p) => (
        <a
          href={`/blog/${p.id}/`}
          class="group bg-card border border-border rounded-xl p-7 hover:shadow-elegant hover:-translate-y-1 transition-all duration-300 flex flex-col"
        >
          <p class="text-xs uppercase tracking-widest text-accent mb-3 font-medium">Blog · {p.data.category}</p>
          <h3 class="font-serif text-2xl font-bold mb-3 text-foreground group-hover:text-primary transition-colors leading-snug">
            {p.data.title}
          </h3>
          <p class="text-muted-foreground text-sm leading-relaxed flex-1">{p.data.excerpt}</p>
          <div class="mt-5 flex items-center justify-between text-xs text-muted-foreground">
            <span class="inline-flex items-center gap-1.5"><Calendar className="w-3.5 h-3.5" />{formatDate(p.data.date)}</span>
            <span class="inline-flex items-center gap-2 text-primary font-medium text-sm group-hover:gap-3 transition-all">
              Read <ArrowRight className="w-4 h-4" />
            </span>
          </div>
        </a>
      ))}
    </div>

    {(featured.bestOf || featured.report) && (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
      {featured.bestOf && (
      <a
        href={`/best-of/${featured.bestOf.slug}/`}
        class="group bg-card border border-border rounded-xl p-7 hover:shadow-elegant hover:-translate-y-1 transition-all duration-300 flex flex-col"
      >
        <p class="text-xs uppercase tracking-widest text-accent mb-3 font-medium">Best Of</p>
        <h3 class="font-serif text-2xl font-bold mb-3 text-foreground group-hover:text-primary transition-colors leading-snug">
          {featured.bestOf.title}
        </h3>
        <p class="text-muted-foreground text-sm leading-relaxed flex-1">{featured.bestOf.intro}</p>
        <span class="inline-flex items-center gap-2 text-primary font-medium text-sm mt-5 group-hover:gap-3 transition-all">
          See the picks <ArrowRight className="w-4 h-4" />
        </span>
      </a>
      )}
      {featured.report && (
      <a
        href={`/research/${featured.report.slug}/`}
        class="group bg-card border border-border rounded-xl p-7 hover:shadow-elegant hover:-translate-y-1 transition-all duration-300 flex flex-col"
      >
        <p class="text-xs uppercase tracking-widest text-accent mb-3 font-medium">Research Report</p>
        <h3 class="font-serif text-2xl font-bold mb-3 text-foreground group-hover:text-primary transition-colors leading-snug">
          {featured.report.title}
        </h3>
        <p class="text-muted-foreground text-sm leading-relaxed flex-1">{featured.report.summary}</p>
        <span class="inline-flex items-center gap-2 text-primary font-medium text-sm mt-5 group-hover:gap-3 transition-all">
          Open the report <ArrowRight className="w-4 h-4" />
        </span>
      </a>
      )}
    </div>
    )}
  </section>
</SiteLayout>
