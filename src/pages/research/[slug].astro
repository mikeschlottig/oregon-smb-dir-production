---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getCollection, render } from "astro:content";
import { reportSchema, breadcrumbSchema } from "@/lib/schema";
import { ChevronRight, Download, FileText } from "lucide-react";

export async function getStaticPaths() {
  const reports = await getCollection("research");
  return reports.map((report) => ({
    params: { slug: report.id },
    props: { report },
  }));
}

const { report } = Astro.props;
const { Content, headings } = await render(report);

const tocHeadings = headings.filter((h: any) => h.depth === 2 || h.depth === 3);

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const schemas = [
  reportSchema(report, siteUrl),
  breadcrumbSchema([
    { name: "Home", url: siteUrl },
    { name: "Research", url: `${siteUrl}/research` },
    { name: report.data.title, url: `${siteUrl}/research/${report.id}` },
  ]),
];
---
<SiteLayout
  title={`${report.data.title} — Oregon SMB Directory Research`}
  description={report.data.summary}
  ogType="article"
  schemas={schemas}
>
  <header class="bg-primary text-primary-foreground pt-32 pb-14 px-4">
    <div class="container mx-auto max-w-5xl">
      <nav class="flex items-center gap-2 text-primary-foreground/70 text-sm mb-6 flex-wrap">
        <a href="/" class="hover:text-primary-foreground">Home</a>
        <ChevronRight className="w-4 h-4" />
        <a href="/research/" class="hover:text-primary-foreground">Research</a>
        <ChevronRight className="w-4 h-4" />
        <span class="text-primary-foreground line-clamp-1">{report.data.title}</span>
      </nav>

      <div class="grid md:grid-cols-[1fr_auto] gap-6 items-start">
        <div>
          <p class="text-gold text-xs font-medium uppercase tracking-widest mb-3">
            {report.data.category}{report.data.published && <> · {report.data.published}</>}
          </p>
          <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight mb-5">
            {report.data.title}
          </h1>
          <p class="text-lg md:text-xl text-primary-foreground/85 leading-relaxed max-w-3xl">
            {report.data.summary}
          </p>
        </div>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 bg-gold text-gold-foreground px-5 py-3 rounded font-medium hover:bg-gold/90 transition-colors flex-shrink-0"
        >
          <Download className="w-4 h-4" /> Request PDF
        </a>
      </div>
    </div>
  </header>

  <article class="container mx-auto max-w-3xl px-4 py-16">
    {tocHeadings.length >= 3 && (
      <nav aria-label="Table of contents" class="mb-12 p-6 rounded-xl border border-border bg-muted/40">
        <p class="text-xs uppercase tracking-widest text-muted-foreground mb-3 inline-flex items-center gap-2">
          <FileText className="w-3.5 h-3.5" /> Contents
        </p>
        <ol class="space-y-1.5 text-sm">
          {tocHeadings.map((h: any) => (
            <li class={h.depth === 3 ? "pl-4" : ""}>
              <a href={`#${h.slug}`} class="text-foreground/80 hover:text-primary">{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:scroll-mt-24 prose-h1:text-4xl prose-h2:text-3xl prose-h2:mt-12 prose-h3:text-2xl prose-a:text-primary prose-a:underline prose-a:underline-offset-2 prose-strong:text-foreground prose-li:text-foreground/90 prose-p:text-foreground/90 prose-p:leading-relaxed prose-table:text-sm prose-th:bg-muted prose-th:text-left prose-th:p-3 prose-td:p-3 prose-td:border prose-td:border-border prose-th:border prose-th:border-border">
      <Content />
    </div>
  </article>
</SiteLayout>
