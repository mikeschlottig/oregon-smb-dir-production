---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { researchReports } from "@/data/content";
import { ArrowRight, FileText } from "lucide-react";
---
<SiteLayout title="Research Reports — Oregon SMB Directory">
  <section class="bg-primary text-primary-foreground pt-32 pb-16 px-4">
    <div class="container mx-auto max-w-4xl text-center">
      <p class="text-gold text-sm uppercase tracking-widest mb-3">Research Reports</p>
      <h1 class="font-serif text-5xl md:text-6xl font-bold mb-4">
        Data on the <span class="italic text-gold">I-5 Corridor</span>
      </h1>
      <p class="text-primary-foreground/80 text-lg max-w-2xl mx-auto">
        Original research and quarterly indices from our editorial team — covering economy,
        housing, small business, and tourism across all 10 cities.
      </p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
      {researchReports.map((r) => (
        <a
          href={`/research/${r.slug}`}
          class="group bg-card border border-border rounded-xl p-8 hover:shadow-elegant hover:-translate-y-1 transition-all duration-300 flex flex-col"
        >
          <div class="flex items-start justify-between mb-5">
            <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
              <FileText className="w-6 h-6" />
            </div>
            <div class="text-right text-xs text-muted-foreground">
              <p class="uppercase tracking-wider text-accent font-medium">{r.category}</p>
              <p class="mt-1">{r.published} · {r.pages} pages</p>
            </div>
          </div>
          <h2 class="font-serif text-2xl font-bold leading-snug mb-3 text-foreground group-hover:text-primary transition-colors">
            {r.title}
          </h2>
          <p class="text-muted-foreground text-sm leading-relaxed mb-6 flex-1">{r.summary}</p>
          <div class="grid grid-cols-3 gap-3 pt-5 border-t border-border">
            {r.metrics.map((m) => (
              <div>
                <div class="font-serif text-xl font-bold text-primary">{m.value}</div>
                <div class="text-[10px] uppercase tracking-wider text-muted-foreground mt-0.5">
                  {m.label}
                </div>
              </div>
            ))}
          </div>
          <span class="mt-5 inline-flex items-center gap-2 text-primary font-medium text-sm group-hover:gap-3 transition-all">
            Open report <ArrowRight className="w-4 h-4" />
          </span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
