---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Pagination from "@/components/Pagination.astro";
import ResearchGrid from "@/components/ResearchGrid.astro";
import { getResearchPages, researchPageMeta } from "@/lib/research-pages";
import { trail, visibleTrail, breadcrumbListSchema } from "@/lib/breadcrumbs";

const { reports, totalPages, pages } = await getResearchPages();
const first = pages[0];
const { title, description } = researchPageMeta(1, totalPages, first.start, first.end, reports.length);

const categoryCounts = reports.reduce<Record<string, number>>((acc, r) => {
  acc[r.data.category] = (acc[r.data.category] || 0) + 1;
  return acc;
}, {});

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const crumbs = trail([
    { name: "Research" },
]);

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    url: `${siteUrl}/research/`,
    description,
  },
  breadcrumbListSchema(crumbs, siteUrl),
];
---
<SiteLayout
  title={title}
  description={description}
  schemas={schemas}
>
  <section class="bg-primary text-primary-foreground pt-32 pb-16 px-4">
    <div class="container mx-auto max-w-4xl text-center">
      <Breadcrumbs crumbs={visibleTrail(crumbs)} tone="inverse" class="mb-6" />
      <p class="text-gold text-sm uppercase tracking-widest mb-3">Research Library</p>
      <h1 class="font-serif text-5xl md:text-6xl font-bold mb-4">
        Deep Dives Across <span class="italic text-gold">Oregon</span>
      </h1>
      <p class="text-primary-foreground/80 text-lg max-w-2xl mx-auto">
        {reports.length} primary-source research reports across industries, cities, and emerging sectors —
        original data, vendor benchmarks, and deep-dive analyses from the LEVERAGE AI editorial team.
      </p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-12">
    <div class="flex flex-wrap gap-2 justify-center text-xs">
      {Object.entries(categoryCounts).map(([cat, n]) => (
        <span class="px-3 py-1.5 rounded-full bg-muted text-muted-foreground uppercase tracking-wider">
          {cat} ({n})
        </span>
      ))}
    </div>
  </section>

  <section class="container mx-auto px-4 pb-16">
    <ResearchGrid reports={first.items} />
    <Pagination baseUrl="/research/" currentPage={1} totalPages={totalPages} />
  </section>
</SiteLayout>
