---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { ArrowRight, FileText } from "lucide-react";

const reports = (await getCollection("research")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const categoryCounts = reports.reduce<Record<string, number>>((acc, r) => {
  acc[r.data.category] = (acc[r.data.category] || 0) + 1;
  return acc;
}, {});
---
<SiteLayout
  title="Research Library — Oregon SMB Directory"
  description="Industry research reports and deep-dive analyses across Oregon's small-business economy."
>
  <section class="bg-primary text-primary-foreground pt-32 pb-16 px-4">
    <div class="container mx-auto max-w-4xl text-center">
      <p class="text-gold text-sm uppercase tracking-widest mb-3">Research Library</p>
      <h1 class="font-serif text-5xl md:text-6xl font-bold mb-4">
        Deep Dives on the <span class="italic text-gold">I-5 Corridor</span>
      </h1>
      <p class="text-primary-foreground/80 text-lg max-w-2xl mx-auto">
        {reports.length} primary-source research reports across industries, cities, and emerging sectors —
        original data, vendor benchmarks, and deep-dive analyses from the LEVERAGE AI editorial team.
      </p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-12">
    <div class="flex flex-wrap gap-2 justify-center text-xs">
      {Object.entries(categoryCounts).map(([cat, n]) => (
        <span class="px-3 py-1.5 rounded-full bg-muted text-muted-foreground uppercase tracking-wider">
          {cat} ({n})
        </span>
      ))}
    </div>
  </section>

  <section class="container mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reports.map((r) => (
        <a
          href={`/research/${r.id}/`}
          class="group bg-card border border-border rounded-xl p-7 hover:shadow-elegant hover:-translate-y-1 transition-all duration-300 flex flex-col"
        >
          <div class="flex items-start justify-between mb-5">
            <div class="w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
              <FileText className="w-5 h-5" />
            </div>
            <p class="text-[10px] uppercase tracking-wider text-accent font-medium text-right">
              {r.data.category}
            </p>
          </div>
          <h2 class="font-serif text-xl font-bold leading-snug mb-3 text-foreground group-hover:text-primary transition-colors line-clamp-3">
            {r.data.title}
          </h2>
          <p class="text-muted-foreground text-sm leading-relaxed mb-6 flex-1 line-clamp-5">{r.data.summary}</p>
          <span class="mt-auto inline-flex items-center gap-2 text-primary font-medium text-sm group-hover:gap-3 transition-all">
            Open report <ArrowRight className="w-4 h-4" />
          </span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
