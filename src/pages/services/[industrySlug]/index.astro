---
/**
 * Industry service hub — /services/{industry}/
 *
 * The breadcrumb trail on every service-category page names this level, so it has to
 * exist. It lists the service categories in this industry that actually have cities
 * meeting the publication threshold, which is what makes it a real page rather than
 * a placeholder created to satisfy a link.
 */
import SiteLayout from "@/layouts/SiteLayout.astro";
import TldrCard from "@/components/TldrCard.astro";
import { cities } from "@/data/cities";
import { industries } from "@/data/industries";
import { serviceCategories } from "@/data/serviceCategories";
import { matchBusinesses } from "@/data/matchBusinesses";
import { trail, visibleTrail, breadcrumbListSchema } from "@/lib/breadcrumbs";

export async function getStaticPaths() {
  const withCategories = new Set(
    serviceCategories
      .filter((category) => cities.some((c) => matchBusinesses(c.slug, category).length >= 3))
      .map((category) => category.industrySlug)
  );
  return industries
    .filter((industry) => withCategories.has(industry.slug))
    .map((industry) => ({ params: { industrySlug: industry.slug } }));
}

const { industrySlug } = Astro.params;
const industry = industries.find((i) => i.slug === industrySlug)!;

/** Categories in this industry, each with the cities that clear the threshold. */
const categories = serviceCategories
  .filter((category) => category.industrySlug === industrySlug)
  .map((category) => ({
    category,
    cities: cities.filter((c) => matchBusinesses(c.slug, category).length >= 3),
  }))
  .filter((entry) => entry.cities.length > 0);

const totalListings = categories.reduce(
  (sum, { category, cities: cs }) =>
    sum + cs.reduce((n, c) => n + matchBusinesses(c.slug, category).length, 0),
  0
);

/**
 * Per-city coverage for this industry. An industry with a single service category
 * would otherwise render as a title and one card — a hub thin enough to be a stub.
 * This is the page's own data, not filler: how many qualifying providers each city
 * has in this industry, which is the question the hub exists to answer.
 */
const cityCoverage = cities
  .map((city) => ({
    city,
    count: categories.reduce(
      (n, { category }) => n + matchBusinesses(city.slug, category).length,
      0
    ),
    categoryCount: categories.filter(
      ({ category }) => matchBusinesses(city.slug, category).length >= 3
    ).length,
  }))
  .filter((entry) => entry.count > 0)
  .sort((a, b) => b.count - a.count);

const licensedCategories = categories.filter(({ category }) => category.licenseRequired);

const siteUrl = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");
const crumbs = trail([
  { name: "Services", path: "/services/" },
  { name: industry.name },
]);

const title = `${industry.name} Services in Oregon`;
const description = `Browse ${categories.length} ${industry.name.toLowerCase()} service categories across ${cities.length} Oregon cities, selected through explicit provider-category policies.`;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    url: `${siteUrl}/services/${industrySlug}/`,
    description,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: categories.length,
      itemListElement: categories.map(({ category }, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: category.displayName,
        item: `${siteUrl}/services/${industrySlug}/${category.slug}/`,
      })),
    },
  },
  breadcrumbListSchema(crumbs, siteUrl),
];
---

<SiteLayout title={title} description={description} schemas={schemas}>
  <TldrCard
    breadcrumb={visibleTrail(crumbs)}
    eyebrow="Oregon"
    title={title}
    tagline={`${categories.length} service categories drawn from ${totalListings} source-observed ${industry.name.toLowerCase()} records.`}
    stats={[
      { value: categories.length.toString(), label: "Service Categories" },
      { value: totalListings.toString(), label: "Qualified Listings" },
    ]}
  />

  <section class="container mx-auto px-4 py-14">
    <h2 class="font-playfair text-3xl font-bold mb-3" style="color: var(--c-pine);">
      {industry.name} categories
    </h2>
    <p class="mb-10 max-w-3xl" style="color: var(--c-sage);">
      {industry.description} A category appears below only where at least three
      source-observed providers in a city qualify under that category's selection policy.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {categories.map(({ category, cities: categoryCities }) => (
        <article class="rounded-lg border p-6" style="border-color: var(--c-stone);">
          <h3 class="font-inter text-xl font-semibold mb-2">
            <a href={`/services/${industrySlug}/${category.slug}/`} style="color: var(--c-pine);">
              {category.displayName}
            </a>
          </h3>
          <p class="text-sm mb-4" style="color: var(--c-sage);">{category.shortDescription}</p>
          {category.licenseRequired && category.licenseAuthority && (
            <p class="text-xs mb-4" style="color: var(--c-river);">
              Licensed trade — {category.licenseAuthority}
            </p>
          )}
          <div class="flex flex-wrap gap-2">
            {categoryCities.map((c) => (
              <a
                href={`/services/${industrySlug}/${category.slug}/${c.slug}/`}
                class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium"
                style="background-color: var(--c-sky); color: var(--c-pine);"
              >
                {c.name}
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container mx-auto px-4 pb-16">
    <h2 class="font-playfair text-2xl font-bold mb-3" style="color: var(--c-pine);">
      {industry.name} coverage by city
    </h2>
    <p class="mb-6 max-w-3xl" style="color: var(--c-sage);">
      {totalListings} qualifying {industry.name.toLowerCase()} providers are spread across
      {cityCoverage.length} of the {cities.length} cities this directory covers. A city
      appears in a service category only where at least three providers there qualify
      under that category's selection policy, so the counts below are what passed the
      gate rather than what the source files contain.
      {licensedCategories.length > 0 && (
        <span>
          {" "}{licensedCategories.length} of these {categories.length} categories cover
          licensed trades in Oregon — verify a provider's current standing with the
          issuing authority named on the category page before hiring.
        </span>
      )}
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {cityCoverage.map(({ city, count, categoryCount }) => (
        <a
          href={`/city/${city.slug}/${industrySlug}/`}
          class="rounded-lg border p-5"
          style="border-color: var(--c-stone); color: var(--c-pine);"
        >
          <span class="block font-inter text-lg font-semibold">{city.name}</span>
          <span class="block text-sm" style="color: var(--c-sage);">
            {count} qualifying provider{count === 1 ? "" : "s"} across {categoryCount}
            {" "}service categor{categoryCount === 1 ? "y" : "ies"} · {city.county} County
          </span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
