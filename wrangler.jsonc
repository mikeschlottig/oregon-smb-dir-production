{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "oregonsmbdirectory-site",
  "compatibility_date": "2025-09-23",
  "observability": { "enabled": true },

  // Assets-only Worker — no `main` script. Astro builds to ./dist; wrangler
  // uploads the directory and serves files directly from Cloudflare's edge.
  // not_found_handling: "404-page" matches Astro multi-page output (dist/404.html).
  // Worker script runs ONLY for the first-party PostHog relay; everything else is served
  // straight from static assets.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/lv-relay/*"]
  },

  // Custom domain routes in Cloudflare account (ceo@leverageai.network)
  "routes": [
    { "pattern": "oregonsmbdirectory.com", "custom_domain": true },
    { "pattern": "www.oregonsmbdirectory.com", "custom_domain": true }
  ]
}
