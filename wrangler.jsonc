{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "oregonsmbdirectory-site",
  "compatibility_date": "2025-09-23",
  "observability": { "enabled": true },

  // Assets-only Worker — no `main` script. Astro builds to ./dist; wrangler
  // uploads the directory and serves files directly from Cloudflare's edge.
  // not_found_handling: "404-page" matches Astro multi-page output (dist/404.html).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }

  // Custom domain — uncomment after DNS for oregonsmbdirectory.com is live in
  // this CF account. Both apex and www hit this Worker; redirect www → apex
  // can be done with a Page Rule or a small `main` handler.
  // "routes": [
  //   { "pattern": "oregonsmbdirectory.com/*", "custom_domain": true },
  //   { "pattern": "www.oregonsmbdirectory.com/*", "custom_domain": true }
  // ]
}
