{
  // Preview deployments ONLY. Same assets as wrangler.jsonc but NO routes/custom domains, so a
  // preview can never claim oregonsmbdirectory.com. Deploy: wrangler deploy --config wrangler.preview.jsonc
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "oregonsmbdirectory-preview",
  "compatibility_date": "2025-09-23",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
